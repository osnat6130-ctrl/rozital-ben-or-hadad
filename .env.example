# משתני הסביבה של פאנל הניהול.
# בפרודקשן: Cloudflare > Workers & Pages > הפרויקט > Settings > Variables.
# בפיתוח מקומי: להעתיק ל-.env.local (הקובץ לא נכנס לגיט).

# סוד לחתימת עוגיית ההתחברות - מחרוזת אקראית ארוכה. ליצירה:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# המשתמשות שיכולות להיכנס לפאנל, כמערך JSON בשורה אחת.
# כל רשומה נוצרת עם: node scripts/hash-password.mjs <שם-משתמש> "<שם לתצוגה>"
# הסיסמה עצמה לא נשמרת - רק hash.
ADMIN_USERS=[{"username":"osnat","name":"אוסנת","hash":"pbkdf2$25000$...$..."},{"username":"rozital","name":"רוזיטל","hash":"pbkdf2$25000$...$..."}]

# טוקן GitHub (Fine-grained) עם הרשאה אחת בלבד: Contents - Read and write,
# על הריפו הזה בלבד. ליצירה: github.com > Settings > Developer settings
# > Personal access tokens > Fine-grained tokens.
GITHUB_TOKEN=
GITHUB_REPO=osnat6130-ctrl/rozital-ben-or-hadad
# הענף שאליו הפאנל כותב. לבדיקות מקומיות אפשר ענף נפרד, למשל admin-test.
GITHUB_BRANCH=main

# מוגדר רק בהרצה מקומית - גורם לעוגייה לא להיות Secure (כי אין https)
LOCAL_DEV=1
